<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  #7 — macOS Hardened Runtime entitlements.

  Referenced by package.json build.mac.entitlements /
  entitlementsInherit. Required for:
  - Hardened Runtime (package.json build.mac.hardenedRuntime: true) to run at
    all under Gatekeeper without disabling protections.
  - getUserMedia() microphone capture (electron/main.ts display-media/audio
    capture flow) — without com.apple.security.device.audio-input, macOS
    denies mic access outright regardless of the in-app TCC prompt.
  - System-audio loopback capture (desktopCapturer + { audio: 'loopback' } in
    main.ts) is gated by NSScreenCaptureUsageDescription plus attended TCC
    consent. There is no public Developer ID screen-recording entitlement.
  - JIT/unsigned-memory and library-validation exceptions are Electron's
    documented non-MAS defaults. Helper processes receive the narrower
    build/entitlements.mac.inherit.plist instead of these capture permissions.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
