{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-electron",
    "rootDir": "electron"
  },
  "include": ["electron/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "release", "electron/**/*.test.ts"]
}
