{
  "name": "platform-desktop",
  "version": "0.1.0",
  "description": "Meeting Intelligence Desktop Client — Electron + React + TypeScript",
  "author": "Platform Team",
  "main": "dist-electron/main.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "security:audit": "npm audit --audit-level=moderate",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "i18next": "^24.0.0",
    "keycloak-js": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-redux": "^9.2.0",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.acik.platform.meeting-intelligence",
    "productName": "Meeting Intelligence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons",
        "filter": [
          "*.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Meeting Intelligence needs microphone access to record meeting audio for live transcription.",
        "NSScreenCaptureUsageDescription": "Meeting Intelligence needs screen recording permission to capture system audio for meeting transcription."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "desktop": {
        "entry": {
          "Name": "Meeting Intelligence",
          "Comment": "Meeting Intelligence — Faz 24"
        }
      }
    },
    "publish": {
      "provider": "github",
      "owner": "Halildeu",
      "repo": "platform-desktop"
    }
  }
}
