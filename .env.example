# Keycloak — Halil #1 config (platform-test realm, public client + PKCE S256)
# Public client: secret yok. Gerçek değerler bu örnekte; .env'e kopyalayın.
KEYCLOAK_BASE_URL=https://testai.acik.com
KEYCLOAK_REALM=platform-test
KEYCLOAK_CLIENT_ID=platform-desktop
KEYCLOAK_REDIRECT_PORT=8123
KEYCLOAK_SCOPE=openid profile email

# audio-gateway (#2 REST chunks) — backend base URL
GATEWAY_BASE_URL=

# meeting-service (#3 runtime contract) — defaults can match the same test edge URL.
MEETING_BASE_URL=

# recorder runtime (#2) — use meeting-service MeetingResponse.id (UUID) for an existing meeting.
# Random desktop-generated meeting IDs and legacy MTG-* codes are forbidden.
RECORDER_MEETING_ID=
RECORDER_DEVICE_ID=desktop-1

# optional live STT word-level partial stream — platform-ai live-stt-service /ws/stream.
# Keep empty to use only audio-gateway transcript-events. Local dev may use ws://localhost:18220/ws/stream.
LIVE_STT_STREAM_URL=
